rules_version = '2';

// Reglas de seguridad de PraiseSync Books Web.
// Copia todo este texto en Firebase → Firestore Database → Reglas → Publicar.
// Cambia el correo por el (o los) correos de administración, en minúsculas.

service cloud.firestore {
  match /databases/{database}/documents {

    function esAdmin() {
      return request.auth != null
        && request.auth.token.email in ['leonar92004@gmail.com'];
    }

    // Cuenta del programa de avisos por Telegram: solo puede LEER pedidos.
    // Cambia el correo si usaste otro al crearla en Firebase → Authentication.
    function esBot() {
      return request.auth != null
        && request.auth.token.email == 'bot-telegram@praisesync-books.firebaseapp.com';
    }

    // Un pedido nuevo desde la tienda solo puede traer estos datos.
    function pedidoValido() {
      let d = request.resource.data;
      return d.keys().hasOnly(['cliente', 'items', 'total', 'estado', 'stockDescontado', 'creado'])
        && d.estado == 'pendiente'
        && d.stockDescontado == false
        && d.creado == request.time
        && d.total is number && d.total >= 0
        && d.items is list && d.items.size() > 0 && d.items.size() <= 50
        && d.cliente is map
        && d.cliente.keys().hasOnly(['nombre', 'telefono', 'notas'])
        && d.cliente.nombre is string && d.cliente.nombre.size() > 0 && d.cliente.nombre.size() <= 80
        && d.cliente.telefono is string && d.cliente.telefono.size() >= 7 && d.cliente.telefono.size() <= 20
        && d.cliente.notas is string && d.cliente.notas.size() <= 300;
    }

    // Libros: todos ven los visibles; solo administración crea, edita y ve los ocultos.
    match /libros/{id} {
      allow read: if resource.data.activo == true || esAdmin();
      allow write: if esAdmin();
    }

    // Categorías: todos las ven; solo administración las cambia.
    match /categorias/{id} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // Catálogo resumido que lee la tienda (1 lectura por visita). Lo publica el panel.
    match /tienda/{id} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // Fotos de los libros, separadas para que se carguen solo cuando se ven.
    match /portadas/{id} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // Fotos del interior de los libros (hasta 3 por libro).
    match /interiores/{id} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // Fotos de los banners principales.
    match /banners/{id} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // Pedidos: cualquiera puede crear uno desde la tienda; solo administración los ve y los cambia.
    match /pedidos/{id} {
      allow create: if esAdmin() || pedidoValido();
      allow read: if esAdmin() || esBot();
      allow update, delete: if esAdmin();
    }
  }
}
